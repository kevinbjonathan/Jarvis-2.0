# JARVIS - example environment file
# ===================================================================
# Everything here is optional. JARVIS runs with an empty .env: the default
# brain is the free opencode Zen tier, voice input and output fall back to the
# browser's own speech, and no cloud API key is required.
#
# Copy this file to .env in the repository root:
#     copy .env.example .env
#
# The bridge (bridge/env.mjs) reads .env from the repository root and also
# parses the git-ignored jarvis-secrets.cmd used by the Windows launchers.
# An already-exported environment variable always wins over either file.
#
# The Vite frontend reads VITE_* variables. Put frontend-only overrides in
# .env.local. Only VITE_-prefixed values ever reach the browser.
#
# Never commit .env, jarvis-secrets.cmd, OAuth tokens, or data/.


# ===================================================================
# BRIDGE - local server (bridge/server.mjs)
# ===================================================================
# These are shown with their defaults. Leave a value unset or empty to accept
# the default. Empty values in .env are ignored.

# Port for the WebSocket and HTTP endpoints. Default 8787.
# If you change it, change VITE_BRIDGE_URL to match.
# JARVIS_BRIDGE_PORT=8787

# Model used by the local opencode brain. Default opencode/big-pickle.
# JARVIS_MODEL=opencode/big-pickle

# opencode executable. Default opencode, resolved from PATH.
# JARVIS_OPENCODE=opencode

# Reasoning variant passed to opencode. Default low.
# On the free model, medium/high can turn an ~11 s turn into 30-55 s.
# JARVIS_EFFORT=low

# Allow effectful tools: send, click, type, delete, install, pay.
# Off by default. `npm run bridge:writes` sets this to 1 for you.
# Read the decideTool gate in bridge/server.mjs before enabling it.
# JARVIS_ALLOW_WRITES=0

# Extra browser origins allowed to open the agent WebSocket, comma separated.
# Local dev origins are already allowed. Default: none.
# JARVIS_ALLOWED_ORIGINS=

# Accept clients that send no Origin header at all. Off by default, because
# local malware also sends no Origin header.
# JARVIS_ALLOW_NO_ORIGIN=0

# Extra directories the /file endpoint may serve from, comma separated.
# The home and system temp directories are always included.
# JARVIS_FILE_ROOTS=

# ElevenLabs voice id used by the bridge's speech endpoint. Default: George.
# JARVIS_VOICE_ID=JBFqnCBsd6RMkjVDRZzb

# ElevenLabs API key. Optional. With it, JARVIS speaks in the ElevenLabs voice
# and transcribes with Scribe; without it, the browser's own speech is used.
# ELEVENLABS_API_KEY=

# Google OAuth client for Gmail and Calendar. Optional.
# Create a Desktop-app OAuth client in Google Cloud Console, then open
# http://127.0.0.1:8787/auth/google in the same browser to consent.
# JARVIS_GOOGLE_CLIENT_ID=
# JARVIS_GOOGLE_CLIENT_SECRET=

# Chrome DevTools Protocol ports and browser path. Optional overrides.
# JARVIS_CHROME_PORT=9333
# JARVIS_CDP_PORT=9222
# JARVIS_CHROME_PATH=


# ===================================================================
# OBSERVABILITY - local traces and aggregate counters
# ===================================================================
# Metadata only. Prompts, replies, tool payloads and secrets are never stored.
# JARVIS_OBSERVABILITY=0
# JARVIS_LOCAL_TELEMETRY=1
# Reserved for a future opt-in; Phase 1 never stores conversation content.
# JARVIS_TRACE_CONTENT=0
# Delete traces older than this many days at startup. Default 30.
# JARVIS_TRACE_RETENTION_DAYS=30


# ===================================================================
# AI GATEWAY - optional cloud models for plain conversation
# ===================================================================
# The fast router and the local opencode brain need none of this. The gateway
# adds a cloud option for ordinary questions and is free-first by default.
#
# In AI_BILLING_MODE=free_only (the default) a model is used only when it is
# verified free: an OpenRouter ":free" id, "openrouter/free", or an id listed
# in AI_FREE_MODELS. JARVIS will not silently route an exhausted free tier
# onto a paid one.

# auto (OpenRouter, Gemini, then NVIDIA), a pinned provider, or none.
# AI_PROVIDER=auto

# free_only refuses unverified/paid models. standard allows any configured
# model and can spend money. Change this deliberately.
# AI_BILLING_MODE=free_only

# Fall back to the local opencode brain when the cloud is unreachable.
# Set to none to surface cloud failures instead of hiding them.
# AI_FALLBACK=opencode

# Try the next configured provider after a timeout. Partial replies are never
# replayed. Retries can add time and make another API call.
# AI_FALLBACK_ON_TIMEOUT=1

# Per-provider limits. After timeout failover, elapsed attempts add together.
# AI_TIMEOUT_MS=15000
# AI_REASONING_TIMEOUT_MS=30000
# AI_MAX_TOKENS=220
# AI_REASONING_MAX_TOKENS=700

# Send preferences and retrieved mail/calendar text to the cloud.
# OFF by default. Cloud turns carry no private data unless this is 1.
# AI_CLOUD_DATA=0

# Comma-separated model ids you have verified are free, beyond the ":free"
# convention. Required for Gemini and NVIDIA models without a :free suffix.
# AI_FREE_MODELS=

# --- OpenRouter (recommended free provider) ---
# Key: https://openrouter.ai/keys
# OPENROUTER_API_KEY=
# OPENROUTER_MODEL=openrouter/free
# Optional stronger model for analytical questions; must also be free.
# OPENROUTER_REASONING_MODEL=

# --- Google Gemini (optional secondary provider) ---
# Create a key in Google AI Studio. A key pasted into chat is exposed and
# must be revoked.
# GEMINI_API_KEY=
# GEMINI_MODEL=
# GEMINI_REASONING_MODEL=
# In free_only mode, list the exact model in AI_FREE_MODELS only after
# confirming it is free for your account. Otherwise use standard mode.

# --- NVIDIA NIM (optional) ---
# Key: https://build.nvidia.com
# NVIDIA_API_KEY=
# NVIDIA_MODEL=
# Override the endpoint, for example a self-hosted NIM.
# NVIDIA_BASE_URL=
# Declare that NVIDIA_MODEL is on NVIDIA's free tier. Required for free_only.
# NVIDIA_FREE=0

# --- OmniRoute (local, disabled by default) ---
# Isolated loopback-only adapter. It is not in the active routing chain and
# will not be called unless enabled. Both the exact model id and the allowlist
# must agree with the OmniRoute key. Auto ids, wildcards, non-loopback hosts,
# query strings, and unapproved models are rejected.
# JARVIS_OMNIROUTE_ENABLED=0
# JARVIS_OMNIROUTE_BASE_URL=http://127.0.0.1:20128/v1
# JARVIS_OMNIROUTE_API_KEY=
# JARVIS_OMNIROUTE_MODEL=
# JARVIS_OMNIROUTE_ALLOWED_MODELS=
# JARVIS_OMNIROUTE_MAX_TOKENS=220
# JARVIS_OMNIROUTE_TIMEOUT_MS=25000

# Separate canary path used only by `npm run canary:omniroute`. Off by default
# and needs both switches. It sends one fixed synthetic prompt and never joins
# normal chat or voice routing.
# JARVIS_OMNIROUTE_CANARY=0
# JARVIS_OMNIROUTE_MODEL=zai-org/glm-5.2
# JARVIS_OMNIROUTE_ALLOWED_MODELS=zai-org/glm-5.2


# ===================================================================
# FRONTEND - Vite (put these in .env.local)
# ===================================================================

# bridge (recommended) or direct.
# VITE_BACKEND=bridge

# Where the bridge listens. Keep in step with JARVIS_BRIDGE_PORT.
# VITE_BRIDGE_URL=ws://localhost:8787

# system (browser speechSynthesis) or kokoro (neural voice in the browser).
# VITE_TTS_ENGINE=system
# VITE_KOKORO_VOICE=bm_george

# Prefer the bridge's ElevenLabs voice when a key is available.
# VITE_USE_ELEVENLABS=false

# Optional browser-side ElevenLabs key. Prefer the server-side key above;
# anything in VITE_* ships to the browser.
# VITE_ELEVENLABS_API_KEY=
# VITE_ELEVENLABS_VOICE_ID=

# Picovoice access key. The Porcupine dependency exists, but the current wake
# path uses browser SpeechRecognition; this is reserved for the offline
# wake-word roadmap item.
# VITE_PICOVOICE_ACCESS_KEY=

# Legacy direct mode only. When VITE_BACKEND=direct, the browser calls the
# Anthropic API itself and this key ships to the browser. The default bridge
# mode never reads it. Use only for a local demo.
# VITE_ANTHROPIC_API_KEY=
