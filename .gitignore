# Logs
logs
*.log
npm-debug.log*
yarn-debug.log*
yarn-error.log*
pnpm-debug.log*
lerna-debug.log*

node_modules
dist
dist-ssr
coverage
*.local
*.tsbuildinfo

# Environment files. The bridge's env loader (bridge/env.mjs) reads .env from
# the repo root, and it holds API keys - never commit it. The example is kept.
# Vite reads VITE_* variables from .env.local.
.env
.env.*
!.env.example

# Editor directories and files
.vscode/*
!.vscode/extensions.json
.idea
.DS_Store
*.suo
*.ntvs*
*.njsproj
*.sln
*.sw?

# Copied out of node_modules by scripts/start.mjs - 34MB of build output.
public/mediapipe/

# Private keys and launcher secrets. Copy jarvis-secrets.example.cmd to this
# name. The file is parsed by the bridge and the PowerShell launcher.
jarvis-secrets.cmd
.jarvis-probe.mjs

# Local application data: memory, preferences, notifications, tabs, traces,
# browser state, and the SQLite database. These are personal data, not source.
data/
*.db
*.db-shm
*.db-wal
*.db-journal
*.sqlite
*.sqlite3

# JARVIS runtime state and OAuth credentials. Tokens are server-side only.
bridge/.oc/auth/
bridge/.oc/notifications.json
bridge/.oc/preferences.json
bridge/.oc/preferences.json.*

# opencode custom tools are regenerated from bridge/hudtools.mjs at boot.
bridge/.oc/tools/

# Local editor/agent launch configuration.
.claude/

# Internal upgrade backups and one-off patch scripts.
docs/stage-h-backups/
